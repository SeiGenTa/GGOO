generator client {
    provider      = "prisma-client"
    output        = "../generated/prisma"
    binaryTargets = ["linux-musl-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
}

model User {
    id                  String          @id @default(uuid())
    nombre              String
    email               String          @unique
    apodo               String?
    password            String
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt
    es_admin            Boolean         @default(false)
    es_valido           Boolean         @default(false)
    aprobado_por_admin  Boolean         @default(false)
    rechazado_por_admin Boolean         @default(false)
    pichangas           Pichanga[]      @relation("PichangaAdmins")
    inscripciones       Inscripcion[]
    permisos            String[]
    roles               Rol[]           @relation("UserRoles")
    tarjetas            Tarjetas[]      @relation("CardsUser")
    tarjetasAsignadas   Tarjetas[]      @relation("CardsAsignadas")
    castigos            Castigo[]       @relation("CastigosUser")
    castigosCancelados  Castigo[]       @relation("CastigosCancelados")
    reclamosCartas      ReclamosCarta[] @relation("ReclamosAtendidos")
    posiciones          String[]        @default([])
    cumpleanos          DateTime?
    refreshTokens       RefreshToken[]
}

model RefreshToken {
    id               String    @id @default(uuid())
    token            String    @unique
    user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId           String
    ip               String?
    userAgent        String?
    fechaCreacion    DateTime  @default(now())
    fechaExpiracion  DateTime
    esValido         Boolean   @default(true)
    revocadoEn       DateTime?
    motivoRevocacion String?

    @@index([userId])
    @@index([fechaExpiracion])
    @@index([esValido])
}

model Rol {
    id         String   @id @default(uuid())
    users      User[]   @relation("UserRoles")
    nombre     String
    permisos   String[]
    is_default Boolean  @default(false)
}

model Pichanga {
    id                    String        @id @default(uuid())
    nombre                String?
    lugar                 String?
    fecha                 DateTime
    admins                User[]        @relation("PichangaAdmins")
    createdAt             DateTime      @default(now())
    updatedAt             DateTime      @updatedAt
    maxJugadores          Int           @default(18)
    fechaInicioIncripcion DateTime
    inscripciones         Inscripcion[]
}

model Inscripcion {
    id                String    @id @default(uuid())
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId            String
    pichanga          Pichanga  @relation(fields: [pichangaId], references: [id], onDelete: Cascade)
    pichangaId        String
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    tiempoSalidaLista DateTime?
    posicionEnLista   Int?
}

model Tarjetas {
    id             String          @id @default(uuid())
    user           User            @relation("CardsUser", fields: [userId], references: [id], onDelete: Cascade)
    userId         String
    tipoCarta      String
    razon          String
    usado          Boolean
    quienAsigno    User?           @relation("CardsAsignadas", fields: [quienAsignoId], references: [id], onDelete: SetNull)
    quienAsignoId  String?
    reclamosCartas ReclamosCarta[]
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    venceEn        DateTime        @default(dbgenerated("CURRENT_TIMESTAMP + INTERVAL '1 month'"))
}

model ReclamosCarta {
    id                     String   @id @default(uuid())
    tarjeta                Tarjetas @relation(fields: [tarjetaId], references: [id], onDelete: Cascade)
    tarjetaId              String
    razon                  String
    fechaReclamo           DateTime
    atendido               Boolean  @default(false)
    respuesta              String?
    administradorAtendio   User?    @relation("ReclamosAtendidos", fields: [administradorAtendioId], references: [id], onDelete: SetNull)
    administradorAtendioId String?
}

model Castigo {
    id               String   @id @default(uuid())
    user             User     @relation("CastigosUser", fields: [userId], references: [id], onDelete: Cascade)
    userId           String
    tipoCastigo      String
    razon            String
    fechaInicio      DateTime
    fechaFin         DateTime
    fueCancelada     Boolean  @default(false)
    quienCancelo     User?    @relation("CastigosCancelados", fields: [quienCanceloId], references: [id], onDelete: SetNull)
    quienCanceloId   String?
    razonCancelacion String?
}
